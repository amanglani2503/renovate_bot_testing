{
  "extends": [
    "config:base",
    ":enableVulnerabilityAlerts",
    ":assignAndReview"
  ],

  "timezone": "Asia/Kolkata",
  "schedule": ["after 11:15pm and before 11:20pm"],

  "reviewers": ["amitpawar7475", "shubhampanse938@gmail.com"],
  "assignees": ["ambermanglani8871"],

  "labels": ["dependencies"],

  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,

  "dependencyDashboard": true,

  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all minor and patch updates",
      "requiredStatusChecks": ["build"]
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}